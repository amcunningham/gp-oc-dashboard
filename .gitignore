# Raw source downloads (GPPS practice CSVs etc.) live in the TOP-LEVEL data/ folder
# locally but must not be committed - they are ~1.3GB and available from the publishers.
# Processed outputs belong in research/data, which is tracked.
# (Leading slash matters: without it, git also ignores research/data.)
/data/
~$*
*.crdownload

# Unpublished drafts - never commit
/drafts/

# Local trash staging (holds files awaiting manual deletion, e.g. old named-practice
# briefings and stale git locks) - never commit
/_to_delete/

# Raw NHS download bundles under research/data — keep only the extracted/processed outputs
research/data/cbt_jun26/callsanswered/
research/data/cbt_jun26/durations/
research/data/cbt_jun26/*.zip
research/data/cbt_jun26/*.xlsx
research/data/rebuild_20260730/downloads/
